# CloudOps Sentinel backend configuration. Copy to .env (in this backend/ directory) and adjust.
# Every variable has a safe default; nothing here is a secret yet.

# Data mode: "local" (simulated scenarios). "aws" arrives on Day 5 and currently refuses to start.
SENTINEL_MODE=local

# Label shown in the console.
SENTINEL_ENVIRONMENT=dev

# AWS region shown in the console (and used by AWS mode later).
SENTINEL_REGION=eu-west-3

# Minutes of telemetry collected per sync (baseline history + incident window).
SENTINEL_SYNC_WINDOW_MINUTES=180

# Dev aid: slows the simulated collector so the syncing state and the sync lock
# can be observed. Keep at 0 except for break exercises.
SENTINEL_SIMULATED_LATENCY_SECONDS=0

# SQLite database file. Default: backend/data/sentinel-<mode>.db (one file per mode, so
# simulated and AWS incidents never mix). Delete the file to start from an empty history.
# SENTINEL_DB_PATH=data/sentinel-local.db

# --- Investigation provider (Day 3, ADR 0015) ------------------------------------------
# "mock" (default): deterministic rules, no network, no key. Its output is labelled in the UI.
# "openai_compatible": one POST to {SENTINEL_LLM_BASE_URL}/chat/completions.
SENTINEL_LLM_PROVIDER=mock

# Recommended for development and demos: Ollama on this machine (nothing leaves it).
#   ollama pull <model>   then:
# SENTINEL_LLM_PROVIDER=openai_compatible
# SENTINEL_LLM_BASE_URL=http://localhost:11434/v1
# SENTINEL_LLM_MODEL=<model you pulled>
# Hosted providers also work (check their terms first, see ADR 0015), e.g.
# SENTINEL_LLM_BASE_URL=https://api.groq.com/openai/v1

# Secret. Leave empty for Ollama. Never commit a real key: .env is gitignored.
# SENTINEL_LLM_API_KEY=

# Local models can be slow on a CPU.
SENTINEL_LLM_TIMEOUT_SECONDS=60
SENTINEL_LLM_MAX_TOKENS=1500
